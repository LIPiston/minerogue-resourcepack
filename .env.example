# OpenAI-compatible image generation endpoint.
# You may set either the full endpoint or the service root.
IMAGE_API_URL=https://api.smai.ai
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_API_TIMEOUT=180

# Optional: local checkout of Retro-Diffusion/pixel-art-fixer.
# When set, generated images are corrected before 32x32 output.
PIXEL_FIXER_DIR=

# Optional defaults for the generated prompt.
IMAGE_STYLE=pixel art game item sprite, crisp hard edges, limited palette
IMAGE_NEGATIVE_PROMPT=blurry, photorealistic, 3d render, text, letters, watermark, logo, multiple weapons, hands, character, background clutter
